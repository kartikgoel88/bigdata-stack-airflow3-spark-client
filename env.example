# Big Data Stack Airflow 3 with Spark Client - Environment Variables
# Copy this file to .env and modify as needed: cp env.example .env

# ========== Software Versions ==========
AIRFLOW_VERSION=3.0.2
AIRFLOW_PYTHON_VERSION=3.11
SPARK_VERSION=3.5.8
POSTGRES_VERSION=13
JAVA_VERSION=11

# ========== Docker Image Configuration ==========
AIRFLOW_IMAGE_NAME=bigdata-stack-airflow-spark
AIRFLOW_IMAGE_TAG=latest

# ========== Spark Configuration ==========
SPARK_HOME=/opt/spark
SPARK_MASTER=spark://spark-master:7077
SPARK_CONF_DIR=/opt/spark/conf
JAVA_HOME_PATH=/usr/lib/jvm/default-java
PYSPARK_PYTHON=python3
PYSPARK_DRIVER_PYTHON=python3

# ========== Airflow Configuration ==========
AIRFLOW_HOME=/opt/airflow
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_FERNET_KEY=
AIRFLOW_DAGS_PAUSED_AT_CREATION=True
AIRFLOW_LOAD_EXAMPLES=False
AIRFLOW_JWT_SECRET=development-jwt-secret-key-change-in-production
AIRFLOW_WEB_PORT=8082
AIRFLOW_WEB_PORT_CONTAINER=8080

# ========== PostgreSQL Configuration ==========
POSTGRES_PORT_CONTAINER=5432

# Airflow PostgreSQL
AIRFLOW_POSTGRES_HOST=airflow-postgres
AIRFLOW_POSTGRES_CONTAINER_NAME=airflow-postgres
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_PORT=5433

# ========== Container Names and Hostnames ==========
AIRFLOW_INIT_CONTAINER_NAME=airflow-init
AIRFLOW_INIT_HOSTNAME=airflow-init
AIRFLOW_API_SERVER_CONTAINER_NAME=airflow-api-server
AIRFLOW_API_SERVER_HOSTNAME=airflow-api-server
AIRFLOW_DAG_PROCESSOR_CONTAINER_NAME=airflow-dag-processor
AIRFLOW_DAG_PROCESSOR_HOSTNAME=airflow-dag-processor
AIRFLOW_SCHEDULER_CONTAINER_NAME=airflow-scheduler
AIRFLOW_SCHEDULER_HOSTNAME=airflow-scheduler

# ========== Resource Limits ==========
POSTGRES_MEMORY_LIMIT=1G
POSTGRES_MEMORY_RESERVATION=512M
AIRFLOW_API_SERVER_MEMORY_LIMIT=2G
AIRFLOW_API_SERVER_MEMORY_RESERVATION=1G
AIRFLOW_DAG_PROCESSOR_MEMORY_LIMIT=1G
AIRFLOW_DAG_PROCESSOR_MEMORY_RESERVATION=512M
AIRFLOW_SCHEDULER_MEMORY_LIMIT=2G
AIRFLOW_SCHEDULER_MEMORY_RESERVATION=1G

# ========== Healthcheck Configuration ==========
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5
HEALTHCHECK_START_PERIOD=10s
AIRFLOW_HEALTHCHECK_START_PERIOD=60s

# ========== Network Configuration ==========
NETWORK_NAME=bigdata-hadoop-network
NETWORK_DRIVER=bridge
NETWORK_EXTERNAL=true
HOST_DOCKER_INTERNAL=host.docker.internal

# ========== Timezone ==========
TZ=UTC

# ========== Airflow Admin User ==========
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User

# ========== Wait/Retry Configuration ==========
WAIT_RETRIES=60
